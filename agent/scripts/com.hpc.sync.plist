<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.hpc.sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/hpc-sync</string>
    </array>

    <!-- ⚠️ A SEPARATE job from the enforcer, and that separation is the whole
         claim. V6 boots this out and requires byte-identical enforcer logs.
         Nothing here may become a dependency of com.hpc.enforcerd: no
         `KeepAlive` on another job, no shared pid, no ordering. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- The daemon owns its own cadence (§4.2's one timer), so launchd must
         not also have an opinion. No StartInterval. -->

    <!-- ⚠️ NO HPC_BASE_URL here. The base URL lives in
         /var/db/homeparentcontrol/base_url, written by `install.sh
         --base-url`. A value in this file is overwritten by every pkg
         upgrade (the payload reinstalls it), and `launchctl setenv` is
         refused under SIP — the first real smoke test hit both. The
         variable still overrides the file if set, for running by hand.
         Plain HTTP is X4, accepted. -->

    <key>StandardErrorPath</key>
    <string>/var/log/homeparentcontrol/sync.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
