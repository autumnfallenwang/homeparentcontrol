# Runtime override for server-side (SSR) fetches. In k3s the chart sets this to
# the in-cluster Service DNS (http://homeparentcontrol-api). Omit locally.
# API_URL=http://homeparentcontrol-api

# Browser-side API origin. Next inlines NEXT_PUBLIC_* at build time, so this is
# baked into the client bundle by the Dockerfile build arg.
NEXT_PUBLIC_API_URL=http://localhost:3001
