# PostgreSQL connection string. `pnpm dev` starts this container via
# scripts/db-start.sh — note port 5433, not 5432 (homework's dev db owns 5432).
DATABASE_URL=postgresql://hpc:hpc@localhost:5433/hpc_dev

# HTTP server port (local dev; 52001 in the container)
API_PORT=3001

# CORS — comma-separated origins allowed to call the API. Doubles as
# better-auth's trustedOrigins from phase 2, so the two can never drift.
CORS_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info

# better-auth. Generate the secret with: openssl rand -base64 32
# In the cluster both come from the homeparentcontrol-secrets Secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Retention ladder (see src/config.ts). The boot assertion refuses to start
# unless RAW_SAMPLE_RETENTION_DAYS exceeds AGENT_MAX_QUEUE_AGE_DAYS, otherwise
# raw events are pruned before the projector ever reads them.
RAW_SAMPLE_RETENTION_DAYS=90
AGENT_MAX_QUEUE_AGE_DAYS=14
